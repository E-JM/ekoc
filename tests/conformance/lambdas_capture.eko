// Lambdas carry no annotations; they capture by snapshot and receive their
// bit from the body. A pure factory may return a `!` closure
// (Clauses 6.4, 7.9).

inc: (Int) -> Int = (n): n + 1

mk_logger: (out: Out) -> (Int) !-> Int =
    (n): out.println(show(n)); n + 1

capture_snapshot: test =
    base: Int = 10
    read: () -> Int = (): base
    base := 20
    assert_eq(read(), 10)
    assert_eq(base, 20)

factory_output: test =
    out := Out.tee(Out.null(), (s): assert_eq(s, "3"))
    log := mk_logger(out)
    assert_eq(log(3), 4)

dispatcher_bit: test =
    out := Out.tee(Out.null(), (s): assert(s.starts_with("item-")))
    xs: []String = {"item-a", "item-b"}
    xs.each((s): out.println(s))

zero_annotation: test =
    xs: []Int = {1, 2, 3}
    assert_eq(xs.map(inc), {2, 3, 4})
    assert_eq(xs.map((n): n * 2), {2, 4, 6})
    assert_eq(xs.filter((n): n > 1), {2, 3})
