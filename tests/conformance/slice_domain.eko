// The slice domain: a start and a length whose request must lie
// entirely inside the sequence, including requests whose start and
// length would overflow if added (Clauses 9.10.1, 9.11.1).

near_max: Int = 9_223_372_036_854_775_806

inside: test =
    xs: []Int = {1, 2, 3, 4}
    assert_eq(xs.slice(1, 2), Some {2, 3})
    assert_eq(xs.slice(0, 4), Some {1, 2, 3, 4})
    assert_eq(xs.slice(4, 0), Some {})
    assert_eq("abcd".slice(1, 2), Some "bc")
    assert_eq("abcd".slice(0, 0), Some "")

outside: test =
    xs: []Int = {1, 2, 3, 4}
    assert_eq(xs.slice(-1, 2), None)
    assert_eq(xs.slice(1, -2), None)
    assert_eq(xs.slice(3, 2), None)
    assert_eq(xs.slice(5, 0), None)
    assert_eq("abcd".slice(3, 2), None)
    assert_eq("abcd".slice(-1, 1), None)

wide_counts: test =
    xs: []Int = {1, 2, 3, 4}
    assert_eq(xs.slice(near_max, 5), None)
    assert_eq(xs.slice(0, near_max), None)
    assert_eq("abcd".slice(near_max, 5), None)
    assert_eq("abcd".slice(0, near_max), None)
