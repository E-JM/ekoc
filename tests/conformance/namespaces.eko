// Namespace rows: the List surface over the structural list in both
// spellings, the scalar arithmetic rows, and an Out capability whose
// world bit flows from the row's arrow (Clauses 7.4.3, 7.9, 9.6, 9.10).

list_surface: test =
    xs: []Int = {3, 1, 2}
    assert_eq(xs.length(), 3)
    assert_eq(xs.reverse().join(","), "2,1,3")
    assert_eq(xs.map((n): n * 2).fold(0, (acc, n): acc + n), 12)
    assert(xs.filter((n): n > 1).sort().eq({2, 3}))
    assert(xs.slice(1, 2).eq(Some ({1, 2})))

list_namespace_spelling: test =
    xs: []String = {"a", "b"}
    assert_eq(List.length(xs), 2)
    assert_eq(List.join(xs, "-"), "a-b")
    assert(List.map(xs, (s): s.eq("a")).eq({True, False}))

scalar_rows: test =
    assert_eq(Int.add(2, 3), 5)
    assert_eq(10.rem(3), 1)
    assert_eq(2.pow(8), 256)
    assert(Int.min.lt(Int.max))
    d: Float = Float.neg(0.5).mul(2.0)
    assert_eq(d, -1.0)

ring_arithmetic: test =
    a: UInt = 12
    b: UInt = 10
    wide: UInt = 70
    assert_eq(a.bxor(b), 6)
    assert_eq(a.band(b), 8)
    assert_eq(a.bor(b), 14)
    assert_eq(a.bnot(), 18446744073709551603)
    assert_eq(a.shl(wide), 0)
    assert_eq(a.shr(wide), 0)
    assert_eq(Int.max.wrapping_add(1), Int.min)
    assert_eq(Int.min.wrapping_neg(), Int.min)
    assert_eq(Int.max.wrapping_mul(2), -2)

out_row_bits: test =
    out: Out = Out.null()
    out.println("checked")
    tee: Out = out.tee((s): out.println(s))
    tee.print("via tee")

Pair: type = [f: Int, s: Int]
Pair.make: ([Int, Int]) -> Pair = (t):
    (f, s) = t
    {f: f, s: s}

namespace_lambda_body: test =
    assert_eq(Pair.make({3, 4}), {f: 3, s: 4})

