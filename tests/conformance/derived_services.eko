// Derived services: show vs inspect, an override through interpolation,
// deep equality, declaration-order `<`, immutable `with`, stable sort_by,
// and capability display (Clauses 9.8, 9.10.1).

Sex: type = Man | Woman
Tree: type t = Leaf t | Node [Tree t, Tree t]
Money: type = [cents: Int, cur: String]
Item: type = [key: Int, tag: String]
Person: type = [name: String, age: Int]

Money.show: (m: Money) -> String = "{m.cur} {m.cents}"

show_vs_inspect: test =
    plain: String = "hi"
    assert_eq(show(plain), "hi")
    assert_eq(inspect(plain), "\"hi\"")
    tagged: [name: String] = {name: "wd"}
    assert_eq(show(tagged), "\{name: \"wd\"}")
    assert_eq(inspect(tagged), "\{name: \"wd\"}")

show_override: test =
    m: Money = {cents: 12500, cur: "USD"}
    assert_eq("{m}", "USD 12500")
    assert_eq(inspect(m), "\{cents: 12500, cur: \"USD\"}")

deep_equality: test =
    t1: Tree Int = Node {Leaf 1, Leaf 2}
    t2: Tree Int = Node {Leaf 1, Leaf 2}
    t3: Tree Int = Node {Leaf 1, Leaf 3}
    assert(t1.eq(t2))
    assert(t1.eq(t3).not())

declaration_order: test =
    man: Sex = Man
    woman: Sex = Woman
    assert(man.lt(woman))

with_is_immutable: test =
    p: Person = {name: "ada", age: 36}
    q := p.with({age: 37})
    assert_eq(p.age, 36)
    assert_eq(q.age, 37)

sort_stability: test =
    items: []Item =
        {{key: 2, tag: "a"}, {key: 1, tag: "b"}, {key: 1, tag: "c"}, {key: 2, tag: "d"}}
    sorted := items.sort_by((x, y): x.key < y.key)
    assert_eq(sorted.map((i): i.tag), {"b", "c", "a", "d"})

capability_display: test =
    assert_eq(show(Out.null()), "<cap>")

// The function form renders its own shape on the display channels, and
// a composite forwards the element's own form (Clause 9.8.3).
function_display: test =
    g: (Int) -> Int = (x): x
    gs: [](Int) -> Int = {g}
    assert_eq(g.show(), "<fn>")
    assert_eq(g.inspect(), "<fn>")
    assert_eq(gs.show(), "\{<fn>}")
    assert_eq(gs.inspect(), "\{<fn>}")

// Equality and display answer over a dictionary whose keys are not
// String: the keys render quoted like any other (Clauses 9.8.3, 9.8.4).
dict_key_domain: test =
    d: [Int] Int = {1: 10, 2: 20}
    assert(d.eq(d))
    assert_eq(d.show(), "\{\"1\": 10, \"2\": 20}")
    assert_eq(d.inspect(), "\{\"1\": 10, \"2\": 20}")

// A fold over an unanchored polymorphic accumulator: the callback's
// case over the accumulator type stays exhaustive (Clause 7.7.2), the
// constructor rows answer at the instantiated type.
fold_callback_patterns: test =
    xs: []Int = {1, 2, 3}
    r: Result Int String =
        xs.fold(Err "", (acc, e): case acc: Err m -> Ok e; Ok v -> Ok (v + e))
    assert_eq(r, Ok 6)
    s: Result Int String =
        xs.fold(Ok 0, (acc, e): case acc: Ok v -> Ok (v + e); Err m -> Err m)
    assert_eq(s, Ok 6)
