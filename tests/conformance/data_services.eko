// Data services: Bytes round trips and append, JSON derivation and external
// tagging, numeric conversions and parse round trips, frozen time, and
// formatting (Clauses 9.5, 9.6, 9.7, 9.9, 9.13.1).

import std/time

Sex: type = Man | Woman
Profile: type = [name: String, sex: Sex]

bytes_text: test =
    b := "héllo".to_bytes()
    assert_eq(b.length(), 6)
    assert_eq(b.to_string(), Ok "héllo")
    assert_eq(b.get(0), Some 104)

bytes_hex: test =
    b := Bytes.from_hex("deadbeef").unwrap()
    assert_eq(b.length(), 4)
    assert_eq(b.to_hex(), "deadbeef")
    assert_eq(Bytes.from_hex(b.to_hex()), Ok b)

bytes_append: test =
    a := "ab".to_bytes()
    c := "cd".to_bytes()
    joined := a ++ c
    assert_eq(joined.to_string(), Ok "abcd")
    assert_eq(joined.get(3), Some 100)

json_record: test =
    p: Profile = {name: "ada", sex: Woman}
    j := p.to_json()
    assert_eq(Profile.from_json(j), Ok p)
    assert_eq(Json.parse(Json.show(j)), Ok j)

json_tagging: test =
    man: Sex = Man
    assert_eq(Json.show(man.to_json()), "\"Man\"")
    ok_num: Result Int String = Ok 3
    jn: Json = ok_num.to_json()
    assert(Json.show(jn).contains("\"Ok\""))
    assert_eq(Json.parse(Json.show(jn)), Ok jn)

json_errors: test =
    assert(Json.parse("not json").is_err())

conversions: test =
    assert_eq(Float.to_int(3.7), Some 3)
    assert_eq(Float.to_int(-0.5), Some 0)
    assert_eq(Float.to_uint(-0.5), None)
    assert_eq(UInt.max.to_int(), None)
    u: UInt = 42
    assert_eq(u.to_int(), Some 42)

parsing: test =
    assert_eq(Int.parse("42"), Ok 42)
    assert_eq(Int.parse("-7"), Ok (-7))
    u42: UInt = 42
    assert_eq(UInt.parse("42"), Ok u42)
    assert_eq(Float.parse(show(3.5)), Ok 3.5)

time_values: test =
    clock := Clock.frozen(Time 0)
    assert_eq(clock.now(), Time 0)
    assert_eq(Duration.secs(2).add(Duration.millis(500)).to_ns(), 2_500_000_000)
    assert_eq(Duration.secs(2).mul(3).to_ns(), 6_000_000_000)
    assert_eq(Time.sub(Time 5, Time 2), Duration 3)

formatting: test =
    assert_eq(255.to_hex(), "ff")
    assert_eq(Float.to_fixed(3.14159, 2), "3.14")
