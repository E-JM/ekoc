// Anchored constructors: same-named constructors of different types
// coexist, and the expected type selects one (Clauses 7.4.6, 7.5.2).

MyResult: type = Ok String | Retry Int
MyBool: type = True | False

once: MyResult = Ok "once"
retry: MyResult = Retry 3
count: Result Int _ = Ok 3

yes: Bool = True
mine: MyBool = True

_yes_no: (b: Bool) -> String =
    case b:
        True -> "yes"
        False -> "no"

_mine_or_not: (b: MyBool) -> String =
    case b:
        True -> "mine"
        False -> "not mine"

anchors: test =
    want: MyResult = Ok "once"
    want_count: Result Int _ = Ok 3
    assert_eq(once, want)
    assert_eq(retry, Retry 3)
    assert_eq(count, want_count)
    assert_eq(_yes_no(yes), "yes")
    assert_eq(_mine_or_not(mine), "mine")

qualified_payloads: test =
    assert_eq(MyResult.Ok("q"), Ok "q")
    assert_eq(MyResult.Retry(7), Retry 7)

// The type-qualified spelling names same-named constructors apart
// without reading the module's surface order (Clause 7.4.4).
Other: type = Ok Int | Stop

named_apart: test =
    a: MyResult = MyResult.Ok("q")
    b: Other = Other.Ok(3)
    assert_eq(a, Ok "q")
    assert_eq(b, Ok 3)
    assert_eq(MyResult.Ok("q"), Ok "q")
    assert_eq(Other.Ok(3), Ok 3)
