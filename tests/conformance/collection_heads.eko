// The head-qualified derived members over List and Dict: every service
// the receiver forms carry lands at the type head too, over the
// structural shape the arguments determine (Clauses 9.8.1, 9.9.3;
// Annex C.3, C.4).

list_eq_head: test =
    xs: []Int = {1, 2}
    ys: []Int = {1, 2}
    zs: []Int = {1, 3}
    assert(List.eq(xs, ys))
    assert(List.ne(xs, zs))

dict_eq_head: test =
    d: [String]Int = {"a": 1}
    e: [String]Int = {"a": 1}
    assert(Dict.eq(d, e))

list_show_head: test =
    xs: []Int = {1, 2}
    assert_eq(List.show(xs), "\{1, 2}")
    assert_eq(List.inspect(xs), "\{1, 2}")

list_json_head: test =
    xs: []Int = {1, 2, 3}
    j: Json = List.to_json(xs)
    assert_eq(Json.show(j), "[1,2,3]")
    r: Result ([]Int) ParseError = List.from_json(j)
    assert_eq(r, Ok xs)

dict_json_head: test =
    d: [String]Int = {"a": 1, "b": 2}
    j: Json = Dict.to_json(d)
    assert_eq(Json.show(j), "\{\"a\":1,\"b\":2}")
    r: Result ([String]Int) ParseError = Dict.from_json(j)
    assert_eq(r, Ok d)

head_json_matches_receiver: test =
    xs: []String = {"a", "b"}
    a: Json = xs.to_json()
    b: Json = List.to_json(xs)
    assert_eq(a, b)
    ra: Result ([]String) ParseError = List.from_json(a)
    rb: Result ([]String) ParseError = List.from_json(b)
    assert_eq(ra, rb)

head_element_shape: test =
    xss: [][]Int = {{1, 2}, {3}}
    j: Json = List.to_json(xss)
    assert_eq(Json.show(j), "[[1,2],[3]]")
    r: Result ([][]Int) ParseError = List.from_json(j)
    assert_eq(r, Ok xss)

vector_head_services: test =
    a: Vector Int = Vector.of({1, 2})
    b: Vector Int = Vector.of({1, 2})
    assert(Vector.eq(a, b))
    assert_eq(Vector.show(a), "\{1, 2}")
    j: Json = Vector.to_json(a)
    assert_eq(Json.show(j), "[1,2]")

// The module-path spelling of the same heads: the qualified form
// resolves, checks, and lowers exactly as the bare one (Clause 7.4.4).

std_qualified_heads: test =
    a: Set Int = std.Set.of({1, 2})
    b: Set Int = std.Set.of({2, 1})
    assert(std.Set.eq(a, b))
    assert_eq(std.Set.show(a), "\{1, 2}")
    j: Json = std.Set.to_json(a)
    assert_eq(Json.show(j), "[1,2]")
    r: Result (Set Int) ParseError = std.Set.from_json(j)
    assert_eq(r, Ok a)
    v: Vector Int = std.Vector.of({1, 2})
    assert(std.Vector.eq(v, std.Vector.of({1, 2})))

std_qualified_declared_rows: test =
    assert_eq(std.String.rep("ab", 2), "abab")
    assert_eq(std.Int.add(2, 3), 5)
    assert_eq(std.List.length({1, 2, 3}), 3)
