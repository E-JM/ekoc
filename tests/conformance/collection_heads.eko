// The head-qualified derived members over List and Dict: every service
// the receiver forms carry lands at the type head too, over the
// structural shape the arguments determine (Clauses 9.8.1, 9.9.3;
// Annex C.3, C.4).

list_eq_head: test =
    xs: []Int = {1, 2}
    ys: []Int = {1, 2}
    zs: []Int = {1, 3}
    assert(List.eq(xs, ys))
    assert(List.ne(xs, zs))

dict_eq_head: test =
    d: [String]Int = {"a": 1}
    e: [String]Int = {"a": 1}
    assert(Dict.eq(d, e))

list_show_head: test =
    xs: []Int = {1, 2}
    assert_eq(List.show(xs), "\{1, 2}")
    assert_eq(List.inspect(xs), "\{1, 2}")

list_json_head: test =
    xs: []Int = {1, 2, 3}
    j: Json = List.to_json(xs)
    assert_eq(Json.show(j), "[1,2,3]")
    r: Result ([]Int) ParseError = List.from_json(j)
    assert_eq(r, Ok xs)

dict_json_head: test =
    d: [String]Int = {"a": 1, "b": 2}
    j: Json = Dict.to_json(d)
    assert_eq(Json.show(j), "\{\"a\":1,\"b\":2}")
    r: Result ([String]Int) ParseError = Dict.from_json(j)
    assert_eq(r, Ok d)

head_json_matches_receiver: test =
    xs: []String = {"a", "b"}
    a: Json = xs.to_json()
    b: Json = List.to_json(xs)
    assert_eq(a, b)
    ra: Result ([]String) ParseError = List.from_json(a)
    rb: Result ([]String) ParseError = List.from_json(b)
    assert_eq(ra, rb)

head_element_shape: test =
    xss: [][]Int = {{1, 2}, {3}}
    j: Json = List.to_json(xss)
    assert_eq(Json.show(j), "[[1,2],[3]]")
    r: Result ([][]Int) ParseError = List.from_json(j)
    assert_eq(r, Ok xss)

vector_head_services: test =
    a: Vector Int = Vector.of({1, 2})
    b: Vector Int = Vector.of({1, 2})
    assert(Vector.eq(a, b))
    assert_eq(Vector.show(a), "\{1, 2}")
    j: Json = Vector.to_json(a)
    assert_eq(Json.show(j), "[1,2]")
