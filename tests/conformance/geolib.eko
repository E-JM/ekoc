// A small library module: a record, an ADT, a private helper, and public
// functions over both. Imported by geolib_use.eko (Clauses 7.2.2, 7.3.1).

Shape: type = Circle Float | Rect [Float, Float]
Point: type = [x: Float, y: Float]

_sum: (a: Float, b: Float) -> Float = a + b

area: (s: Shape) -> Float =
    case s:
        Circle r -> 3.14 * r * r
        Rect {w, h} -> w * h

coord_sum: (p: Point) -> Float =
    _sum(p.x, p.y)

move: (p: Point, dx: Float) -> Point =
    p.with({x: p.x + dx})
