// Self-anchoring with one visible constructor: this module declares no
// constructor named True, so std's is the only one and the reference
// needs no annotation (Clauses 7.4.6, 7.6).

_t = True

self_anchor: test =
    assert(True)

qualified_std_variants: test =
    j: Json = std.Json.Int(5)
    s: Json = std.Json.Str("a")
    assert_eq(j, Int 5)
    assert_eq(s, Str "a")
