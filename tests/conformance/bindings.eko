// Binding forms: initial `=`, rebinding `:=`, tuple splitting, discard,
// inverted-binding chains ending in `Ok`, and the irrefutable destructures
// of a value binding (Clauses 6.3, 7.7.1, 9.2).

_sum_row: (row: []String) -> Result Int String =
    a <- row.get(0).to_result("missing a").try()
    b <- row.get(1).to_result("missing b").try()
    x <- Int.parse(a).map_err((e): "a: {e}").try()
    y <- Int.parse(b).map_err((e): "b: {e}").try()
    total := x + y
    Ok total

_Point: type = [x: Int, y: Int]
_Mono: type = _Mono Int
_Duration: type = _Duration Int
_Box: type t = _Box t

_mono_sub: (a: _Mono, b: _Mono) -> _Duration =
    _Mono x = a
    _Mono y = b
    _Duration (x - y)

initial_binding: test =
    answer: Int = 42
    assert_eq(answer, 42)

rebinding: test =
    answer: Int = 42
    answer := answer + 1
    assert_eq(answer, 43)

capture_snapshot: test =
    base: Int = 10
    read: () -> Int = (): base
    base := 20
    assert_eq(read(), 10)
    assert_eq(base, 20)

tuple_split: test =
    pair: [String, Int] = {"first", 2}
    (a, b) = pair
    assert_eq(a, "first")
    assert_eq(b, 2)

discard: test =
    xs: []Int = {1, 2, 3}
    _ := xs.length()
    assert_eq(xs.length(), 3)

inverted_chain: test =
    assert_eq(_sum_row({"7", "8"}), Ok 15)
    assert_eq(_sum_row({}), Err "missing a")
    assert_eq(_sum_row({"7"}), Err "missing b")

record_split: test =
    p: _Point = {x: 3, y: 4}
    {x, y: yy} = p
    assert_eq(x, 3)
    assert_eq(yy, 4)

record_split_nested: test =
    pair: [_Point, _Point] = {{x: 1, y: 2}, {x: 5, y: 6}}
    (a, {x}) = pair
    assert_eq(a.x + a.y, 3)
    assert_eq(x, 5)

ctor_split: test =
    n := _Mono 41
    _Mono i = n
    assert_eq(i + 2, 43)

ctor_split_generic: test =
    b: _Box String = _Box "seven"
    _Box s = b
    assert_eq(s, "seven")

mono_sub: test =
    assert_eq(show(_mono_sub(_Mono 9, _Mono 4)), "_Duration 5")
