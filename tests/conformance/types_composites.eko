// Composite types: ADTs, records with nested partial update, the newtype
// form, tuples, dictionaries, and one-directional shape adaptation
// (Clauses 6.3.5, 6.6, 7.5).

Color: type = Red | Green | Blue
Address: type = [city: String, zip: String]
Person: type = [name: String, age: UInt, address: Address]
Age: type = Age UInt
Human: type = [name: String, age: Int]

_name: (c: Color) -> String =
    case c:
        Red -> "red"
        Green -> "green"
        Blue -> "blue"

_shift: (p: [Int, Int], d: [Int, Int]) -> [Int, Int] =
    (x, y) = p
    (dx, dy) = d
    {x + dx, y + dy}

_birthday: (a: Age) -> Age =
    case a:
        Age n -> Age (n + 1)

_describe: (p: [name: String, age: Int]) -> String =
    "{p.name}: {p.age}"

adts: test =
    assert_eq(_name(Red), "red")
    assert_eq(_name(Green), "green")
    assert_eq(_name(Blue), "blue")

records: test =
    p: Person = {name: "ada", age: 36, address: {city: "x", zip: "1"}}
    moved := p.with({address: {city: "y"}})
    assert_eq(moved.address.city, "y")
    assert_eq(moved.address.zip, "1")
    assert_eq(p.address.city, "x")

newtype: test =
    assert_eq(_birthday(Age 36), Age 37)

tuples: test =
    p: [Int, Int] = {1, 2}
    d: [Int, Int] = {3, 4}
    assert_eq(_shift(p, d), {4, 6})

dicts: test =
    ages: [String]UInt = {"ada": 36, "grace": 41}
    assert_eq(ages.get("ada"), Some 36)
    assert_eq(ages.length(), 2)

structural_keys: test =
    d: [[Int, Int]]String = {}
    d = d.insert({1, 2}, "one")
    d = d.insert({3, 4}, "three")
    k: [Int, Int] = {1, 2}
    assert_eq(d.get(k), Some "one")
    assert_eq(d.get({3, 4}), Some "three")
    assert_eq(d.get({9, 9}), None)
    points: [[x: Int, y: Int]]String = {}
    points = points.insert({x: 5, y: 6}, "center")
    assert_eq(points.get({x: 5, y: 6}), Some "center")

dict_order: test =
    base: [String]Int = {"a": 1, "b": 2, "c": 3}
    hit: [String]Int = base.insert("a", 9)
    spelled: [String]Int = {"a": 1, "a": 2}
    assert_eq(hit.fold("", (acc, k, _v): if acc == "": k else: acc ++ k),
              "abc")
    assert_eq(spelled.get("a"), Some 2)
    assert_eq(spelled.length(), 1)
    left: [String]Int = {"a": 1, "b": 2}
    right: [String]Int = {"b": 20, "c": 30}
    merged: [String]Int = left ++ right
    assert_eq(merged.get("b"), Some 20)
    assert_eq(merged.fold("", (acc, k, _v): if acc == "": k else: acc ++ k),
              "abc")
    reordered: [String]Int = {"b": 2, "a": 1}
    assert_eq(left.eq(reordered), True)

composites: test =
    empty: []Int = {}
    pair: [String, Int] = {"first", 2}
    (word, n) = pair
    assert_eq(empty.length(), 0)
    assert_eq(word, "first")
    assert_eq(n, 2)

shape_adaptation: test =
    h: Human = {name: "ada", age: 36}
    assert_eq(_describe(h), "ada: 36")
    view: [name: String, age: Int] = h
    assert_eq(view.age, 36)
