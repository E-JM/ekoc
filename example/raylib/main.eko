// raylib [text] example - UTF-8 font loading, written in Eko.
//
// One TrueType file loaded at three sizes through `LoadFontEx`, with an
// explicit codepoint list, so the text mixes Chinese and English. The
// structs the calls touch are mirrored as complete `ctype`s — `Font`
// included, its pointer fields riding as opaque `C.Ptr.Void` aliases —
// and the externs name the raylib symbols directly, no C shim.
//
// Machine words have no arithmetic and are not literal positions, so the
// layout math runs in `Float` and narrows to `F32` once, at the edge of
// the demo's own data: a `Layer` stores exactly the ferry forms the
// draw call takes. The window loop is tail recursion: Eko has no `while`.

/// raylib's `Color`: four unsigned bytes, in C field order.
Color: ctype = [r: U8, g: U8, b: U8, a: U8]

/// raylib's `Vector2`: two floats, in C field order.
Vector2: ctype = [x: F32, y: F32]

/// raylib's `Texture2D`: five machine words, in C field order.
Texture: ctype = [id: U32, width: I32, height: I32, mipmaps: I32, format: I32]

/// raylib's `Font`: the complete C struct, field for field. The pointer
/// fields are aliases owned by raylib's unload protocol; `texture` is a
/// nested ctype.
Font: ctype = [
    base_size: I32,
    glyph_count: I32,
    glyph_padding: I32,
    texture: Texture,
    recs: C.Ptr.Void,
    glyphs: C.Ptr.Void]

init_window: (width: I32, height: I32, title: String) ! = extern "InitWindow"
set_target_fps: (fps: I32) ! = extern "SetTargetFPS"
window_should_close: () !-> Bool = extern "WindowShouldClose"
begin_drawing: () ! = extern "BeginDrawing"
end_drawing: () ! = extern "EndDrawing"
clear_background: (color: Color) ! = extern "ClearBackground"
close_window: () ! = extern "CloseWindow"

/// LoadFontEx rasterizes exactly the codepoints given; the count travels
/// beside the list. A missing glyph draws as raylib's '?'.
font_load: (file: String, size: I32, codepoints: C.In []U32, count: I32) !-> Font = extern "LoadFontEx"
font_unload: (font: Font) ! = extern "UnloadFont"
measure_text_ex: (font: Font, text: String, size: F32, spacing: F32) !-> Vector2 = extern "MeasureTextEx"
draw_text_ex: (font: Font, text: String, pos: Vector2, size: F32, spacing: F32, color: Color) ! = extern "DrawTextEx"

screen_width: I32 = 800
screen_height: I32 = 450
screen_w: Float = 800.0
screen_h: Float = 450.0

raywhite: Color = {r: 245, g: 245, b: 245, a: 255}
maroon: Color = {r: 190, g: 33, b: 55, a: 255}
darkgray: Color = {r: 80, g: 80, b: 80, a: 255}
blue: Color = {r: 0, g: 121, b: 241, a: 255}

font_path: String = "NotoSansSC-demo.ttf"

msg1: String = "你好，世界！这是自定义字体：中文 + English"
msg2: String = "第二行：LoadFontEx 直接渲染 UTF-8 文本"
msg3: String = "第三行：中文、English、标点，全都 OK！:D"

/// ASCII printable codepoints, in the boundary's `U32` element form.
ascii: []U32 = (32..=126).to_list().map((n): n.to_u32().unwrap())

/// Everything the fonts must draw: the ASCII range plus the messages.
codes: []U32 = ascii.append((msg1 ++ msg2 ++ msg3).codepoints())

/// Loads one demo font: LoadFontEx at `size` pixels over the codepoints.
load_font: (size: I32) !-> Font =
    font_load(font_path, size, codes, codes.length().to_i32().unwrap())

/// Centres `text` horizontally, exactly like the C example:
///   x = screenWidth/2 - MeasureTextEx(font, text, size, spacing).x/2
///   y = screenHeight/2 - font.baseSize/2 + dy
centered: (font: Font, text: String, size: Float, spacing: Float,
           dy: Float) !-> Vector2 =
    width := Float.from_f32(measure_text_ex(font, text, size.to_f32(), spacing.to_f32()).x)
    {x: (screen_w / 2.0 - width / 2.0).to_f32(),
     y: (screen_h / 2.0 - size / 2.0 + dy).to_f32()}

/// One line of the demo: a font, the text it draws, and where. The
/// record stores the ferry forms, so the draw call converts nothing.
Layer: type = [
    font: Font,
    text: String,
    pos: Vector2,
    size: F32,
    spacing: F32,
    color: Color]

/// Builds one layer, drawing at the font's own loaded size.
layer: (font: Font, text: String, spacing: Float, dy: Float,
        color: Color) !-> Layer =
    size := Int.from_i32(font.base_size).to_float()
    {font: font,
     text: text,
     pos: centered(font, text, size, spacing, dy),
     size: size.to_f32(),
     spacing: spacing.to_f32(),
     color: color}

/// Draw one frame: every layer, over the raylib white background.
draw_frame: (layers: []Layer) ! =
    begin_drawing()
    clear_background(raywhite)
    layers.each((l): draw_text_ex(l.font, l.text, l.pos, l.size, l.spacing, l.color))
    end_drawing()

/// The game loop: draw until the close button or ESC says stop.
game_loop: (layers: []Layer) ! =
    if window_should_close():
        _
    else:
        draw_frame(layers)
        game_loop(layers)

main: () ! =
    init_window(screen_width, screen_height,
                "raylib [text] example - UTF-8 font (中文 / English)")

    // Fonts must load after the window: the glyph atlas is a GPU texture.
    font1 := load_font(34)
    font2 := load_font(30)
    font3 := load_font(24)

    layers: []Layer = {
        layer(font1, msg1, -3.0, -80.0, maroon),
        layer(font2, msg2, -2.0, -10.0, darkgray),
        layer(font3, msg3, 2.0, 50.0, blue)}

    set_target_fps(60)
    game_loop(layers)

    font_unload(font1)
    font_unload(font2)
    font_unload(font3)
    close_window()
