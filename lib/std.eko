// The standard library root: the core types whose bare names are part of
// the language vocabulary, and the assertion family the implicit import
// opens in every file. The rest of the std surface (the scalar types, the
// container namespaces, the members of the declared types, and the
// compiler services) arrives incrementally; the compiler supplies the
// names this file does not declare yet (Clauses 9.1.1, 9.1.2, 9.14.3).

// The two-valued Boolean type.
Bool: type = True | False

// A domain answer: a payload, or the absence of one.
Option: type t = Some t | None

// A recoverable failure: an `Ok` payload, or the reason it failed.
Result: type t e = Ok t | Err e

// A span between two endpoints of one ordered scalar. The `..` and
// `..=` operators construct it; the constructor is private, so no
// other form exists and the endpoint domain stays the operators'.
Range: type t = _Range [start: t, end: t, closed: Bool]

// A closed failure reason for the parse family: a missing value, a
// malformed one, or one outside the target's limits.
ParseError: type = Empty | Invalid String | OutOfRange

// A wall-clock instant, as nanoseconds since the epoch.
Time: type = Time Int

// The ISO 8601 UTC display: date, time, an optional fraction trimmed
// of trailing zeros, and the zone marker (Clause 9.7.4).
Time.show: (t: Time) -> String =
    case t:
        Time n ->
            date := _civil(n.div(86_400_000_000_000))
            day_ns := n.mod(86_400_000_000_000)
            y := "{date.y}".pad_left(4, '0')
            mon := "{date.m}".pad_left(2, '0')
            day := "{date.d}".pad_left(2, '0')
            day_txt := y ++ "-" ++ mon ++ "-" ++ day
            nanos := day_ns % 1_000_000_000
            frac :=
                if nanos == 0: "" else: "." ++ _nanos_frac(nanos, 9)
            day_txt ++ "T" ++ _clock(day_ns / 1_000_000_000) ++ frac ++ "Z"

// The civil date of a day count since 1970-01-01, floor-division
// throughout, so dates before the epoch decompose the same way
// (Hinnant's civil_from_days).
_civil: (z0: Int) -> [y: Int, m: Int, d: Int] =
    z := z0 + 719_468
    era := z.div(146_097)
    doe := z - era * 146_097
    yoe := (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
    y0 := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    m := if mp < 10: mp + 3 else: mp - 9
    y := if m <= 2: y0 + 1 else: y0
    {y: y, m: m, d: d}

// The time of day of a second count: two digits each.
_clock: (s: Int) -> String =
    hh := "{s / 3600}".pad_left(2, '0')
    mm := "{(s / 60) % 60}".pad_left(2, '0')
    ss := "{s % 60}".pad_left(2, '0')
    hh ++ ":" ++ mm ++ ":" ++ ss

// A monotonic reading, as nanoseconds from an arbitrary epoch.
Mono: type = Mono Int

// A signed span of time, in nanoseconds.
Duration: type = Duration Int

// The decimal-seconds display: whole seconds, a fraction of at most
// nine digits with its trailing zeros carried away, and the unit
// (Clause 9.7.4).
Duration.show: (d: Duration) -> String =
    case d:
        Duration n ->
            m := n.abs()
            q := m / 1_000_000_000
            r := m % 1_000_000_000
            body :=
                if r == 0: "{q}" else: "{q}." ++ _nanos_frac(r, 9)
            sign :=
                if n < 0: "-" else: ""
            sign ++ body ++ "s"

// The fractional nanosecond digits, shared by the time displays: a
// trailing zero of the remainder drops one digit and one place
// together, so the padding never refills it.
_nanos_frac: (r: Int, width: UInt) -> String =
    if r != 0 && r % 10 == 0:
        _nanos_frac(r / 10, width - 1)
    else:
        "{r}".pad_left(width, '0')

// The interchange form: the seven JSON variants.
Json: type =
    | Null
    | Bool Bool
    | Int Int
    | Float Float
    | Str String
    | Arr []Json
    | Obj ([String]Json)

// The minimal text form: no whitespace, keys in insertion order, and
// only the mandatory escapes (Clause 9.9.2).
Json.show: (j: Json) -> String =
    case j:
        Null -> "null"
        Bool b -> if b: "true" else: "false"
        Int i -> "{i}"
        Float f -> "{f}"
        Str s -> "\"" ++ _json_escape(s) ++ "\""
        Arr xs -> "[" ++ xs.join(",") ++ "]"
        Obj o -> "\{" ++ o.fold("", (acc, k, v): _json_entry(acc, k, v)) ++ "}"

// One object entry: the escaped key, the value's own show, and the
// separator the fold's accumulator carries.
_json_entry: (acc: String, k: String, v: Json) -> String =
    entry := "\"" ++ _json_escape(k) ++ "\":" ++ v.show()
    if acc == "": entry else: acc ++ "," ++ entry

// The escaped text of one string, one scalar at a time.
_json_escape: (s: String) -> String = _json_chars(s.chars())

_json_chars: (cs: []Char) -> String =
    case cs:
        {} -> ""
        {c, ..rest} -> _json_char(c) ++ _json_chars(rest)

// The two mandatory escapes and the control characters as four
// lowercase hex digits; every other scalar stands as itself.
_json_char: (c: Char) -> String =
    case c:
        '"' -> "\\\""
        '\\' -> "\\\\"
        _ ->
            n := c.to_code()
            if n < 32: "\\u" ++ n.to_hex().pad_left(4, '0')
            else: String.from_char(c)

// Panics when `c` is False. Pure and always enabled.
assert: (c: Bool) -> _ =
    case c:
        True -> _
        False -> panic("assert failed")

// Panics when the arguments are not equal. Both lock to one type.
assert_eq: (a: t, b: t) -> _ =
    case a.eq(b):
        True -> _
        False -> panic("assert_eq failed: {inspect(a)} != {inspect(b)}")

// Panics when the arguments are equal. Both lock to one type.
assert_ne: (a: t, b: t) -> _ =
    case a.eq(b):
        True -> panic("assert_ne failed: {inspect(a)} == {inspect(b)}")
        False -> _
